{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schema/interstellar.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "targetClass": {
      "type": "string",
      "enum": [
        "asteroid",
        "comet"
      ]
    },
    "population": {
      "type": "string",
      "const": "interstellar"
    },
    "displayName": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "designation": {
      "type": "string",
      "minLength": 1
    },
    "solution": {
      "type": "object",
      "properties": {
        "horizonsRec": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "solutionDate": {
          "type": "string",
          "minLength": 1
        },
        "epochJd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "horizonsRec",
        "solutionDate",
        "epochJd"
      ],
      "additionalProperties": false
    },
    "elements": {
      "type": "object",
      "properties": {
        "semiMajorAxisAU": {
          "type": "number",
          "exclusiveMaximum": 0
        },
        "eccentricity": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "inclinationRad": {
          "type": "object",
          "properties": {
            "$deg": {
              "type": "number"
            }
          },
          "required": [
            "$deg"
          ],
          "additionalProperties": false
        },
        "ascendingNodeRad": {
          "type": "object",
          "properties": {
            "$deg": {
              "type": "number"
            }
          },
          "required": [
            "$deg"
          ],
          "additionalProperties": false
