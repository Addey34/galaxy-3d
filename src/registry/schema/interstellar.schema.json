        "meanAnomalyAtEpochRad": {
          "type": "object",
          "properties": {
            "$deg": {
              "type": "number"
            }
          },
          "required": [
            "$deg"
          ],
          "additionalProperties": false
        },
        "epoch": {
          "type": "object",
          "properties": {
            "$date": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                {
                  "pattern": "Z$"
                }
              ]
            }
          },
          "required": [
            "$date"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "semiMajorAxisAU",
        "eccentricity",
        "inclinationRad",
        "ascendingNodeRad",
        "argPerihelionRad",
        "meanAnomalyAtEpochRad",
        "epoch"
      ],
      "additionalProperties": false
    },
    "color": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{6}$"
    },
    "facts": {
