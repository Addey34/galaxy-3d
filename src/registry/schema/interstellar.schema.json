      "properties": {
        "eccentricity": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/__schema0"
            },
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "method": {
              "type": "string",
              "enum": [
                "measured",
                "derived",
                "illustrative"
              ]
            },
            "asOf": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
            },
            "uncertainty": {
              "$ref": "#/$defs/__schema0"
            },
            "detail": {
              "anyOf": [
