                  "type": "string",
                  "const": "not-yet-sourced"
                },
                {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unsourced": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "en",
                    "fr"
