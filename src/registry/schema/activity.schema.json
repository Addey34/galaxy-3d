{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schema/activity.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        },
        "pt-BR": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr",
        "es",
        "pt-BR"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        },
        "pt-BR": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr",
        "es",
        "pt-BR"
      ],
      "additionalProperties": false
    },
    "tour": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "ages": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 5,
          "maximum": 18
        },
        "to": {
          "type": "integer",
          "minimum": 5,
          "maximum": 18
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "durationMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "subjects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "physics",
          "geography",
          "earthScience",
          "astronomy"
        ]
      }
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "fr": {
            "type": "string",
            "minLength": 1
          },
          "es": {
            "type": "string",
            "minLength": 1
          },
          "pt-BR": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "en",
          "fr",
          "es",
          "pt-BR"
        ],
        "additionalProperties": false
      }
    },
    "material": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "fr": {
            "type": "string",
            "minLength": 1
          },
          "es": {
            "type": "string",
            "minLength": 1
          },
          "pt-BR": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "en",
          "fr",
          "es",
          "pt-BR"
        ],
        "additionalProperties": false
      }
    },
    "years": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 9007199254740991
        },
        "to": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 2100
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "fact"
              },
              "body": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "fact": {
                "type": "string",
                "enum": [
                  "axialTilt"
                ]
              },
              "form": {
                "type": "string",
                "enum": [
                  "value",
                  "complement90"
                ]
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "required": [
              "kind",
              "body",
              "fact",
              "decimals"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "subsolarLatitude",
                  "polarDayLatitude"
                ]
              },
              "event": {
                "type": "string",
                "enum": [
                  "march-equinox",
                  "june-solstice",
                  "september-equinox",
                  "december-solstice"
                ]
              },
              "absolute": {
                "type": "boolean"
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "agrees": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9]*$"
                  },
                  "tolerance": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "value",
                  "tolerance"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "event",
              "decimals"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "dayLength"
              },
              "event": {
                "type": "string",
                "enum": [
                  "march-equinox",
                  "june-solstice",
                  "september-equinox",
                  "december-solstice"
                ]
              },
              "latitude": {
                "type": "number",
                "minimum": -66,
                "maximum": 66
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "kind",
              "event",
              "latitude",
              "longitude"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "apsisDate"
              },
              "event": {
                "type": "string",
                "enum": [
                  "perihelion",
                  "aphelion"
                ]
              },
              "bound": {
                "type": "string",
                "enum": [
                  "earliest",
                  "latest"
                ]
              }
            },
            "required": [
              "kind",
              "event",
              "bound"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "apsisGapPercent",
                  "apsisFluxGainPercent"
                ]
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "required": [
              "kind",
              "decimals"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "parts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              },
              "pt-BR": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en",
              "fr",
              "es",
              "pt-BR"
            ],
            "additionalProperties": false
          },
          "teacher": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              },
              "pt-BR": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en",
              "fr",
              "es",
              "pt-BR"
            ],
            "additionalProperties": false
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1
                },
                "fr": {
                  "type": "string",
                  "minLength": 1
                },
                "es": {
                  "type": "string",
                  "minLength": 1
                },
                "pt-BR": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "en",
                "fr",
                "es",
                "pt-BR"
              ],
              "additionalProperties": false
            }
          },
          "questions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "prompt": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "es": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pt-BR": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "en",
                    "fr",
                    "es",
                    "pt-BR"
                  ],
                  "additionalProperties": false
                },
                "answer": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "es": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pt-BR": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "en",
                    "fr",
                    "es",
                    "pt-BR"
                  ],
                  "additionalProperties": false
                },
                "evidence": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9]*$"
                  }
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "high",
                    "advanced"
                  ]
                }
              },
              "required": [
                "id",
                "prompt",
                "answer",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "teacher",
          "steps",
          "questions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "id",
    "title",
    "summary",
    "tour",
    "ages",
    "durationMinutes",
    "difficulty",
    "subjects",
    "objectives",
    "material",
    "years",
    "values",
    "parts"
  ],
  "additionalProperties": false
}
