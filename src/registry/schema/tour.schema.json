{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schema/tour.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        },
        "pt-BR": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr",
        "es",
        "pt-BR"
      ],
      "additionalProperties": false
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "flyTo"
              },
              "body": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            },
            "required": [
              "kind",
              "body"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "jumpToDate"
              },
              "date": {
                "type": "object",
                "properties": {
                  "$date": {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "pattern": "Z$"
                      }
                    ]
                  }
                },
                "required": [
                  "$date"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "date"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "jumpToEvent"
              },
              "event": {
                "type": "string",
                "enum": [
                  "new-moon",
                  "first-quarter",
                  "full-moon",
                  "third-quarter",
                  "solar-eclipse",
                  "lunar-eclipse",
                  "march-equinox",
                  "june-solstice",
                  "september-equinox",
                  "december-solstice",
                  "perihelion",
                  "aphelion",
                  "opposition",
                  "conjunction"
                ]
              },
              "body": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            },
            "required": [
              "kind",
              "event"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "setTimeScale"
              },
              "scale": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "scale"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "caption"
              },
              "text": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fr": {
                    "type": "string",
                    "minLength": 1
                  },
                  "es": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pt-BR": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "en",
                  "fr",
                  "es",
                  "pt-BR"
                ],
                "additionalProperties": false
              },
              "durationMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "wait"
              },
              "ms": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "ms"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "$schema",
    "id",
    "title",
    "steps"
  ],
  "additionalProperties": false
}
