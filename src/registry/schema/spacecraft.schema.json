{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schema/spacecraft.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "targetClass": {
      "type": "string",
      "const": "spacecraft"
    },
    "displayName": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "launchDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "color": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{6}$"
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "naif": {
          "type": "integer",
          "minimum": -9007199254740991,
          "exclusiveMaximum": 0
        }
      },
      "required": [
        "naif"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "temporal": {
          "type": "object",
          "properties": {
            "interval": {
              "minItems": 1,
              "maxItems": 1,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "pattern": "Z$"
                      }
                    ]
                  },
                  {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "pattern": "Z$"
                      }
                    ]
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "interval"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "temporal"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "$schema",
    "id",
    "targetClass",
    "displayName",
    "description",
    "launchDate",
    "color",
    "identifiers",
    "coverage"
  ],
  "additionalProperties": false
}
