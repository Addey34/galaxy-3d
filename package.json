{
  "name": "package",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ephemeris:generate": "node scripts/generate-horizons-ephemerides.mjs",
    "spk:stage": "node scripts/stage-sat441.mjs",
    "spk:verify": "node scripts/verify-spk-range.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "textures:resize": "node scripts/resize-textures.mjs",
    "textures:audit": "vitest run src/config/textureAssets.test.ts src/config/assetManifest.test.ts && node scripts/audit-textures.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\"",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "tsc --noEmit && eslint . && vitest run",
    "verify:all": "pnpm verify && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.1",
    "@types/three": "^0.184.1",
    "eslint": "^10.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "astronomy-engine": "^2.1.19",
    "three": "^0.176.0"
  }
}
