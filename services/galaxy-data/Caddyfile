# Serveur INTERNE des fichiers du service de données ; le Caddy partagé de la VM le relaie
# (`galaxy-data.adrianguichard.dev`) et y pose le TLS.
{
	admin off
	auto_https off
}

:80 {
	root * /srv/galaxy-data
	encode zstd gzip

	# CORS limité à Galaxy et au développement local : la donnée est publique, la bande
	# passante de la VM ne l'est pas.
	@allowed header_regexp origin Origin ^(https://galaxy\.adrianguichard\.dev|http://localhost:[0-9]+)$
	header @allowed Access-Control-Allow-Origin {re.origin.0}
	header Vary Origin

	# Le manifeste change à chaque passage ; un champ publié ne change jamais (son cycle est
	# dans son chemin).
	@manifest path */manifest.json
	header @manifest Cache-Control "public, max-age=300"
	@field path *.bin
	# `?` : une valeur PAR DÉFAUT, posée seulement si la réponse n'en porte pas. Un 503 du serveur
	# d'archive (`no-store`) ne doit pas devenir immuable un an parce que son chemin finit en .bin.
	header @field ?Cache-Control "public, max-age=31536000, immutable"
	header @field ?Content-Type application/octet-stream

	# Le relief de la Terre (lot 48) : des tuiles dont le RÉPERTOIRE porte le hachage de leur
	# contenu (`assets/height-tiles/earth/<hachage>/…`), donc une adresse ne change jamais d'octets.
	# Son manifeste vit sur le site, pas ici : il est petit et les gardes du dépôt le lisent.
	@heights path *.hgt
	header @heights Cache-Control "public, max-age=31536000, immutable"
	header @heights Content-Type application/octet-stream

	# Rien d'autre n'est servi : ni liste de dossier, ni fichier en cours d'écriture.
	@hidden path */.* *.part
	respond @hidden 404

	# L'archive ERA5 : un champ déjà construit est un fichier comme un autre ; un MANQUANT va au
	# serveur d'archive, qui le construit, l'écrit et le rend (ses 503 disent « plafond atteint »).
	@archiveMissing {
		path /era5/* /era5t/*
		not file
	}
	reverse_proxy @archiveMissing galaxy-data-era5:8080

	file_server
}
